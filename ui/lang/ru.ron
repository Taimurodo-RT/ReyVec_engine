        "menu.continue": "Продолжить",
        "menu.new_game": "Новая игра",
        "menu.save": "Сохранить",
        "menu.settings": "Настройки",
        "menu.language": "Язык: Русский",
        "menu.quit": "Выход",
        "hud.stamina": "Выносливость",
        "hud.coins": "Монеты: {n}",
