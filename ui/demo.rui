// Пример экрана интерфейса игры (шаги И.1–И.2а, решение 0022).
// В песочнице: F3 показывает и прячет, F4 меняет тему. Правка этого файла,
// темы или стилей сразу видна в окне.
// Размеры — в пикселях экрана 1920×1080, на другом окне всё растягивается.

head {
    theme("themes/base")      // переменные: цвета, размеры
    styles("styles/demo")     // как выглядят окна, кнопки, тексты
}

screen Demo {
    // Меню в середине экрана.
    Column(align: stretch) {
        Text("ReyVec").class(title)
        Text("Интерфейс из файлов ui/demo.rui, темы и стилей").class(hint)

        Rect().height(8)

        Stack { Text("Продолжить") }.class(button)
        Stack { Text("Новая игра") }.class(button)
        Stack { Text("Настройки") }.class(button)
        Stack { Text("Выход") }.class(button, danger)
    }
    .class(menu, panel)

    // Полоска выносливости в левом нижнем углу. Своё значение muted действует
    // только внутри этого столбца: подпись светлее, чем в меню.
    Column(spacing: 6) {
        Text("Выносливость").font(18).color(var(muted))
        Stack {
            Rect().size(190, 12).background(var(stamina)).radius(6).align(left)
        }
        .size(260, 12)
        .background(#00000080)
        .radius(6)
    }
    .var(muted: #C8D0DC)
    .anchor(bottom_left, margin: 32)
}
