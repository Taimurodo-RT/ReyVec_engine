// Пример экрана интерфейса игры (шаги И.1–И.3в, решение 0022).
// В песочнице: F3 показывает и прячет, F4 меняет тему.
// Правка этого файла, темы, стилей, языков (ui/lang) или ui/demo.luau сразу видна в окне.
// Что делает кнопка, пишется в её фигурных скобках с маленькой буквы:
//   open(Settings) — открыть экран этого файла, back() — вернуться,
//   close() — спрятать интерфейс, quit() — выйти из игры, log("…") — в консоль,
//   next_lang() и next_theme() — следующий язык и тема,
//   другое имя — функция из ui/demo.luau, например new_game().
// Тексты пишутся ключами: tr("menu.save"), а слова — в ui/lang/ru.ron и en.ron.
// Размеры — в пикселях экрана 1920×1080, на другом окне всё растягивается.

head {
    theme("themes/base")      // переменные: цвета, размеры
    styles("styles/demo")     // как выглядят окна, кнопки, тексты
}

screen Demo {
    // Меню в середине экрана.
    Column(align: stretch) {
        Text("ReyVec").class(title)
        Text(tr("demo.hint")).class(hint)
        // Подсказка видна, только когда игрок на клавиатуре.
        Text(tr("demo.keys")).class(hint)
            .opacity(0)
            .when(input: keyboard) { .opacity(1) }

        Rect().height(8)

        // Мышь подсвечивает кнопку, Tab и стрелки выбирают, Enter нажимает.
        // Что нажато — видно в консоли (~).
        Button(tr("menu.continue")) { close() }
        Button(tr("menu.new_game")) { new_game() }     // функция из ui/demo.luau
        Button(tr("menu.save")).disabled()
        Button(tr("menu.settings")) { open(Settings) }
        // В песочнице «Выйти» только прячет меню; в игре здесь будет quit().
        Button(tr("menu.quit")) { close() }.class(danger)
    }
    .class(menu, panel)

    // Полоска выносливости в левом нижнем углу. Своё значение muted действует
    // только внутри этого столбца: подпись светлее, чем в меню.
    Column(spacing: 6) {
        Text(tr("hud.stamina")).font(18).color(var(muted))
        Stack {
            Rect().size(190, 12).background(var(stamina)).radius(6).align(left)
        }
        .size(260, 12)
        .background(#00000080)
        .radius(6)
        // {n} в тексте заменяется числом. Пока число записано здесь, связь с игрой — И.3.
        Text(tr("hud.coins", n: 120)).font(18).color(var(muted))
    }
    .var(muted: #C8D0DC)
    .anchor(bottom_left, margin: 32)
}

// Второй экран файла: его открывает кнопка «Настройки», «Назад» возвращает в меню.
screen Settings {
    Column(align: stretch) {
        Text(tr("settings.title")).class(title)
        Rect().height(8)
        // settings.lang и settings.theme — имя языка и темы: их даёт песочница.
        Button(tr("settings.language", name: settings.lang)) { next_lang() }
        Button(tr("settings.theme", name: settings.theme)) { next_theme() }
        // Знак $ — связь в обе стороны: ползунок показывает громкость игры и сам её
        // меняет. Мышь тянет, стрелки влево и вправо двигают выбранный ползунок.
        Row(spacing: 16, align: center) {
            Text(tr("settings.volume", n: settings.audio.volume * 100))
            Spacer()
            Slider($settings.audio.volume, from: 0, to: 1, step: 0.05).width(160)
        }
        // Музыку можно включить и клавишей O: переключатель сдвинется сам.
        Row(spacing: 16, align: center) {
            Text(tr("settings.music"))
            Spacer()
            Toggle($settings.audio.music)
        }
        Button(tr("settings.back")) { back() }
    }
    .class(menu, panel)
}
