// Проход «полигоны 3D» с цветом текстур (8.14б2): тот же шейдер, что mesh3d.slang, но
// пишет ещё картинку «цвет полигонов 3D». Движок берёт этот вариант, только если в кадре
// есть материалы с текстурой.
// Точки входа [shader("vertex")] vs_main и [shader("fragment")] fs_main — из
// подключённого файла (build.rs ищет эти пометки).
#define MESH_COLOR 1
#include "mesh3d.slang"
