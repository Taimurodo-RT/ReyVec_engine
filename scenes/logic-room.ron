// Комната логики (этап 9.8–9.11): здесь собираются свойства предметов, события и
// сигналы. Пока — свойства (9.8). Иди от героя в обе стороны.
//
// У любого предмета могут быть:
//   props: { "имя": значение } — свойства: да/нет (true, false), число или текст в
//     кавычках (цвет — "#rrggbb"). Движок понимает сам:
//       damage: 2 — касание ранит героя на 2;
//       burns: true — горит: ранит хотя бы на 1 и мерцает;
//       grab: false — руками (C или E) не взять;
//       glow: true — SDF-объекты предмета светятся.
//     Остальные — свои: их читает скрипт предмета (me.props["имя"]).
//   tags: ["слово", ...] — метки: по ним предмет узнают скрипты (me.tags["слово"]),
//     а с 9.9 — сигналы («кнопка → дверь»).
// N — следующий файл сцены из папки scenes.
(
    format: "reyvec-scene",
    version: 1,
    background: Lab,
    ambient: "#4a505c",
    lights: [
        Sun(from: (0.4, 1.0), color: "#fff0d8", power: 0.7, reach: 0.5, size: 0.04),
    ],
    nodes: [
        (
            name: "герой",
            at: (0.0, -0.5),
            depth: 3,
            shadow: true,
            player: (size: (0.14, 0.28), speed: 1.6, jump: 0.6, jump_time: 0.36, hp: 5),
            shapes: [
                Rect(at: (0.0, -0.02), size: (0.12, 0.2), corner: 0.04, color: "#3b5f8a"),
                Circle(at: (0.0, 0.09), r: 0.05, color: "#e8c9a0"),
            ],
        ),
        (
            name: "границы",
            solids: [
                (at: (0.0, -0.88), size: (8.0, 0.2)),
                (at: (-3.9, 0.6), size: (0.2, 3.2)),
                (at: (3.9, 0.6), size: (0.2, 3.2)),
            ],
            shapes: [
                Rect(at: (0.0, -0.88), size: (8.0, 0.2), color: "#3a3f4a"),
                Rect(at: (-3.9, 0.6), size: (0.2, 3.2), color: "#3a3f4a"),
                Rect(at: (3.9, 0.6), size: (0.2, 3.2), color: "#3a3f4a"),
            ],
        ),

        // Справа: шипы ранят на 2 (damage), жаровня горит (burns). Прыгни через них.
        (
            name: "шипы",
            at: (0.8, -0.78),
            depth: 2,
            props: { "damage": 2 },
            tags: ["опасно"],
            shapes: [
                Polygon(points: [(-0.12, 0.0), (-0.08, 0.08), (-0.04, 0.0), (0.0, 0.08), (0.04, 0.0), (0.08, 0.08), (0.12, 0.0)], color: "#b8bcc8"),
            ],
        ),
        (
            name: "жаровня",
            at: (1.6, -0.76),
            depth: 2,
            props: { "burns": true },
            tags: ["опасно"],
            shapes: [
                Rect(at: (0.0, 0.0), size: (0.3, 0.04), corner: 0.01, color: "#e0602a"),
                Rect(at: (0.0, -0.01), size: (0.3, 0.02), color: "#5a3020"),
            ],
        ),

        // Слева: два ящика. Обычный берётся руками (C или E), приклеенный — нет.
        (
            name: "ящик",
            at: (-0.7, -0.72),
            depth: 2,
            body: (size: (0.12, 0.12), material: Wood),
            shapes: [Rect(at: (0.0, 0.0), size: (0.12, 0.12), corner: 0.01, color: "#b87a40")],
        ),
        (
            name: "приклеенный ящик",
            at: (-1.2, -0.72),
            depth: 2,
            body: (size: (0.12, 0.12), material: Wood),
            props: { "grab": false },
            shapes: [
                Rect(at: (0.0, 0.0), size: (0.12, 0.12), corner: 0.01, color: "#8a6a9a"),
                Rect(at: (0.0, 0.0), size: (0.12, 0.012), color: "#e8e0f0"),
            ],
        ),

        // Фонарь: SDF-шар, свойство glow делает его светящимся.
        (
            name: "фонарь",
            at: (-1.9, 0.1),
            depth: 2,
            props: { "glow": true },
            objects: [(parts: [Circle(at: (0.0, 0.0), r: 0.06)], color: "#ffd070", power: 2.0)],
            lights: [Point(at: (0.0, 0.0), color: "#ffd070", power: 0.8, reach: 1.2, size: 0.03)],
        ),

        // Три качающихся шара с одним скриптом: размах и скорость — свои свойства
        // каждого. Средний с меткой «прячется» пропадает, пока его касается герой.
        (
            name: "шар 1",
            at: (-2.6, -0.45),
            depth: 2,
            script: "scripts/props-demo.luau",
            touch: (0.1, 0.1),
            props: { "размах": 0.04, "скорость": 1.0 },
            shapes: [Circle(at: (0.0, 0.0), r: 0.045, color: "#6a9fd8")],
        ),
        (
            name: "шар 2",
            at: (-2.9, -0.45),
            depth: 2,
            script: "scripts/props-demo.luau",
            touch: (0.1, 0.1),
            props: { "размах": 0.1, "скорость": 2.0 },
            tags: ["прячется"],
            shapes: [Circle(at: (0.0, 0.0), r: 0.045, color: "#d9534f")],
        ),
        (
            name: "шар 3",
            at: (-3.2, -0.45),
            depth: 2,
            script: "scripts/props-demo.luau",
            touch: (0.1, 0.1),
            props: { "размах": 0.2, "скорость": 0.5 },
            shapes: [Circle(at: (0.0, 0.0), r: 0.045, color: "#5ab45a")],
        ),
    ],
)
