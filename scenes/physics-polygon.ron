// Полигон физики (6.13): что умеет Rapier 0.36 в нашем движке. Слева направо: пирамида
// из 210 кубиков, маятник и домино, подвесной мост на шарнирах, колыбель Ньютона,
// пружина, лифт на ползуне с мотором, мельница под дождём из шариков, хрупкая полка,
// машинка с моторами в колёсах, тряпичные куклы, желе, мягкая верёвка с грузом, цепь
// с гирей, сетка-гамак, пушка, которая стреляет в тонкую стену.
//
// Мышь и клавиши: Q (держать) — схватить тело или частицу мягкого тела под курсором и
// тащить; Y — взрыв в точке под курсором. Кнопки мыши — как в игре (левая — удар,
// правая — рывок, средняя двигает камеру; R — вернуть её к герою). N — следующий файл
// сцены из папки scenes.
//
// Всё как в первой комнате: открой файл, поменяй число, сохрани — сцена соберётся
// заново. Новое в файле сцены (у предметов верхнего уровня):
//   body: (...) — физическое тело: size, round: true (круг), capsule: true (капсула),
//     points: [(x, y), ...] (выпуклый многоугольник), density, bounce, friction,
//     fixed: true (неподвижное), damping (сопротивление воздуха), gravity (тяжесть),
//     bullet: true (быстрое тело: не пролетает сквозь тонкое; выброшенные — всегда),
//     material: Wood, Metal, Stone или Rubber (9.6: звук и искры удара; плотность,
//     упругость и трение по умолчанию — от материала, если не указаны).
//   layer: "имя" — слой столкновений предмета (9.6а): встроенные «уровень», «герой»,
//     «враг», «тело» или названный в collision: [(name: "…", ignores: ["…"])] вверху
//     файла; ignores — с какими слоями он не сталкивается (в обе стороны).
//   joints: [(kind: ..., to: ..., at: (x, y), ...)] — сочленения тела:
//     kind: Hinge (шарнир), Weld (сварка), Slider (ползун), Rope (верёвка),
//       Spring (пружина);
//     to: World (к неподвижному миру), Node("имя") (к другому телу), Prev (к
//       предыдущей копии повтора);
//     at — точка на этом предмете, to_at — точка на том, к чему крепим (в его
//       координатах; у мира — тоже в координатах этого предмета);
//     limits: (от, до) — пределы шарнира (градусы) или ползуна; axis — ось ползуна;
//     length, stiffness, damping — у верёвки и пружины;
//     motor: (speed: скорость, force: сила, flip: через сколько секунд разворот);
//     breaks: сила, при которой сочленение рвётся; collide: true — соединённые тела
//       сталкиваются; line: (width, color) — нарисовать нитку; on: First или Last —
//       только первой или последней копии повтора.
//   soft: (shape: ..., ...) — мягкое тело из частиц на пружинках:
//     shape: Rope(to: (x, y), count: N) — верёвка, Jelly(r: радиус, count: N) — желе,
//       Net(size: (w, h), cols: N, rows: M) — сетка;
//     stiffness — жёсткость, damping — гашение дрожания, mass — масса всего тела,
//     pin: Start / Ends (верёвка), Sides / Top (сетка) — что закреплено в воздухе,
//     tear: 0.5 — рвётся, если растянуть на половину, attach_start / attach_end —
//     привязать концы верёвки к телам по имени, color, width — толщина нитей.
//   repeat: (count: N, step: (dx, dy), rows: M, row_step: (dx, dy), shrink: 1,
//     colors: [...]) — N копий предмета с шагом (и M рядов; shrink — на сколько каждый
//     ряд короче: так получается пирамида). Копии зовутся «имя 1», «имя 2»...
//   spawn: (every: секунд, speed: (vx, vy), spread, life: секунд, max: N, width) —
//     предмет-образец: раз в every секунд вылетает новое такое же тело.
(
    format: "reyvec-scene",
    version: 1,
    background: Lab,
    ambient: "#565c68",
    // Слои столкновений (9.6а): «призрак» проходит сквозь «решётку», остальные — нет.
    collision: [(name: "решётка"), (name: "призрак", ignores: ["решётка"])],
    lights: [
        Sun(from: (0.5, 1.0), color: "#fff0d8", power: 0.8, reach: 0.5, size: 0.04),
    ],
    nodes: [
        (
            // Герой: at — середина его прямоугольника столкновений, фигуры вокруг неё.
            // Смотрит вправо; когда бежит влево, отражается сам.
            name: "герой",
            at: (-1.3, -0.5),
            depth: 3,
            shadow: true,
            player: (size: (0.14, 0.28), speed: 1.6, jump: 0.6, jump_time: 0.36, hp: 5),
            // Герой собран из костей (6.8): предмет с bone — часть, которая двигается
            // в анимации. Его at — точка крепления (бедро, плечо, шея): вокруг неё кость
            // поворачивается, а angle — её наклон в покое. Кости: тело, голова, рука,
            // рука_сзади, нога, нога_сзади, плащ; кость внутри кости едет вместе с ней
            // (голова и руки — внутри тела). Позы (стоит, бежит, прыгает, падает, рывок,
            // стена, край, удар) движок считает сам; шаг ноги — звук и пыль.
            children: [
                (
                    bone: "нога_сзади",
                    at: (-0.025, -0.085),
                    depth: -0.02,
                    shapes: [
                        Rect(at: (0.0, -0.027), size: (0.034, 0.054), corner: 0.012, color: "#1f1f25"),
                        Rect(at: (0.008, -0.05), size: (0.044, 0.016), corner: 0.006, color: "#151518"),
                    ],
                ),
                (
                    bone: "нога",
                    at: (0.025, -0.085),
                    depth: 0.02,
                    shapes: [
                        Rect(at: (0.0, -0.027), size: (0.034, 0.054), corner: 0.012, color: "#2a2a30"),
                        Rect(at: (0.008, -0.05), size: (0.044, 0.016), corner: 0.006, color: "#1b1b20"),
                    ],
                ),
                (
                    // Тело крепится у пояса: наклоняется вперёд на бегу.
                    bone: "тело",
                    at: (0.0, -0.085),
                    shapes: [
                        Rect(at: (0.0, 0.055), size: (0.11, 0.13), corner: 0.04, color: "#3b5f8a"),
                        Rect(at: (0.0, 0.0), size: (0.112, 0.016), corner: 0.006, color: "#24384f"),
                        Rect(at: (-0.005, 0.115), size: (0.12, 0.028), corner: 0.012, color: "#c0392b"),
                    ],
                    children: [
                        (
                            // Плащ висит за спиной от шеи, на бегу и в падении развевается.
                            bone: "плащ",
                            at: (-0.03, 0.115),
                            depth: -0.04,
                            shapes: [
                                Path(svg: "M -0.01 0.0 Q -0.05 -0.07 -0.045 -0.13 L 0.02 -0.12 Q 0.0 -0.06 0.025 0.0 Z", color: "#8e2a20"),
                            ],
                        ),
                        (
                            bone: "рука_сзади",
                            at: (-0.02, 0.1),
                            angle: -10.0,
                            depth: -0.03,
                            shapes: [
                                Rect(at: (0.0, -0.035), size: (0.028, 0.07), corner: 0.012, color: "#2f4c6e"),
                                Circle(at: (0.0, -0.072), r: 0.014, color: "#d9b88f"),
                            ],
                        ),
                        (
                            bone: "голова",
                            at: (0.0, 0.13),
                            depth: 0.01,
                            shapes: [
                                Circle(at: (0.0, 0.04), r: 0.052, color: "#e8c9a0"),
                                Path(svg: "M -0.052 0.045 Q -0.04 0.1 0.01 0.094 Q 0.05 0.09 0.05 0.06 Q 0.0 0.075 -0.052 0.045 Z", color: "#4a3426"),
                                Circle(at: (0.026, 0.047), r: 0.011, color: "#1a1a1a"),
                            ],
                        ),
                        (
                            // Передняя рука с коротким клинком: им герой и бьёт.
                            bone: "рука",
                            at: (0.02, 0.1),
                            angle: 20.0,
                            depth: 0.03,
                            shapes: [
                                Rect(at: (0.0, -0.035), size: (0.028, 0.07), corner: 0.012, color: "#46709f"),
                                Rect(at: (0.0, -0.08), size: (0.03, 0.008), color: "#6b4a2a"),
                                Rect(at: (0.0, -0.11), size: (0.012, 0.055), corner: 0.004, color: "#d8dde6"),
                                Circle(at: (0.0, -0.072), r: 0.014, color: "#e8c9a0"),
                            ],
                        ),
                    ],
                ),
            ],
            // Взмах удара: светлый серп перед героем.
            strike: [
                Path(svg: "M 0.08 0.13 Q 0.34 0.0 0.08 -0.13 Q 0.22 0.0 0.08 0.13 Z", color: "#fff1c4"),
            ],
        ),
        (
            name: "границы",
            solids: [
                (at: (10.5, -0.88), size: (25.0, 0.2)),
                (at: (-7.0, -0.88), size: (10.0, 0.2)),
                (at: (-11.95, 0.5), size: (0.2, 3.0)),
                (at: (23.0, 0.5), size: (0.2, 3.0)),
            ],
        ),

        // Формы фигур (9.3): иди от героя влево. Твёрдое — настоящей формой фигуры, а не
        // описанным прямоугольником: звезда вращается, и на ней можно стоять; ящик
        // съезжает по дуге холма; на скруглённой банке не устоять с краю; капля —
        // SDF-объект из кругов.
        (
            name: "звезда",
            at: (-2.7, -0.52),
            depth: 2,
            spin: 18,
            shapes: [
                Polygon(points: [(0.0, 0.24), (0.06, 0.08), (0.23, 0.07), (0.1, -0.03), (0.14, -0.2), (0.0, -0.1), (-0.14, -0.2), (-0.1, -0.03), (-0.23, 0.07), (-0.06, 0.08)], color: "#e0b040", solid: true),
            ],
        ),
        (
            name: "холм",
            at: (-4.3, -0.78),
            depth: 2,
            shapes: [Path(svg: "M -0.9 0 Q 0 0.8 0.9 0 Z", color: "#5a7a4a", solid: true)],
        ),
        (
            name: "ящик на холме",
            at: (-3.85, -0.38),
            depth: 2,
            body: (size: (0.12, 0.12), density: 1.0, friction: 0.3),
            shapes: [Rect(at: (0.0, 0.0), size: (0.12, 0.12), corner: 0.008, color: "#b87a40")],
        ),
        (
            name: "банка",
            at: (-5.5, -0.66),
            depth: 2,
            shapes: [Rect(at: (0.0, 0.0), size: (0.16, 0.24), corner: 0.06, color: "#4f7a8a", solid: true)],
        ),
        (
            name: "капля",
            at: (-6.3, -0.68),
            depth: 2,
            objects: [
                (parts: [Circle(at: (0.0, 0.0), r: 0.09), Circle(at: (0.13, -0.02), r: 0.06), Capsule(from: (-0.12, -0.03), to: (-0.25, -0.03), r: 0.05)], color: "#5ab4ff", solid: true),
            ],
        ),

        // Материалы (9.6): иди от героя влево до конца. Удар звучит материалом тела:
        // дерево стучит и роняет щепки, металл звенит и искрит, камень бухает пылью,
        // резина шлёпает и прыгает. Схвати ящик мышью (Q) и брось: чем сильнее удар,
        // тем громче. Ящики на высокой полке столкни мышью на манекен под ней:
        // тяжёлое, упавшее с высоты, ранит (лёгкое — нет).
        (
            name: "высокая полка",
            at: (-8.85, 0.28),
            depth: 2,
            shapes: [Rect(at: (0.0, 0.0), size: (0.9, 0.05), color: "#4a4a52", solid: true)],
        ),
        (
            name: "железный ящик на полке",
            at: (-8.6, 0.405),
            depth: 2,
            body: (size: (0.2, 0.2), material: Metal),
            shapes: [Rect(at: (0.0, 0.0), size: (0.2, 0.2), corner: 0.01, color: "#8d99a6")],
        ),
        (
            name: "каменный ящик на полке",
            at: (-9.05, 0.405),
            depth: 2,
            body: (size: (0.2, 0.2), material: Stone),
            shapes: [Rect(at: (0.0, 0.0), size: (0.2, 0.2), corner: 0.02, color: "#7b7770")],
        ),
        (
            name: "манекен под полкой",
            at: (-8.22, -0.63),
            depth: 2,
            dummy: (size: (0.16, 0.3), hp: 10, respawn: 2.0, fall: Ragdoll),
            shapes: [
                Rect(at: (0.0, -0.135), size: (0.14, 0.03), corner: 0.01, color: "#3a2a1c"),
                Rect(at: (0.0, -0.07), size: (0.025, 0.12), color: "#5a4028"),
                Rect(at: (0.0, 0.0), size: (0.15, 0.17), corner: 0.05, color: "#b08850"),
                Circle(at: (0.0, 0.11), r: 0.045, color: "#c8a068"),
            ],
        ),
        (
            name: "деревянный ящик",
            at: (-7.8, -0.72),
            depth: 2,
            body: (size: (0.12, 0.12), material: Wood),
            shapes: [Rect(at: (0.0, 0.0), size: (0.12, 0.12), corner: 0.008, color: "#9a6b3f")],
        ),
        (
            name: "железный брусок",
            at: (-7.55, -0.74),
            depth: 2,
            body: (size: (0.14, 0.08), material: Metal),
            shapes: [Rect(at: (0.0, 0.0), size: (0.14, 0.08), corner: 0.006, color: "#a8b4c0")],
        ),
        (
            name: "камень",
            at: (-7.3, -0.73),
            depth: 2,
            body: (points: [(-0.06, -0.05), (0.05, -0.05), (0.07, 0.01), (0.01, 0.06), (-0.06, 0.03)], material: Stone),
            shapes: [Polygon(points: [(-0.06, -0.05), (0.05, -0.05), (0.07, 0.01), (0.01, 0.06), (-0.06, 0.03)], color: "#7b7770")],
        ),
        (
            name: "резиновый мяч",
            at: (-7.05, -0.3),
            depth: 2,
            body: (size: (0.1, 0.1), round: true, material: Rubber),
            shapes: [Circle(at: (0.0, 0.0), r: 0.05, color: "#d9534f")],
        ),
        // Взять и бросить (9.6в): C или E рядом с предметом. Лёгкое (деревянный ящик,
        // камень, мяч) герой поднимает над головой, второе нажатие бросает (со стрелкой
        // вниз — кладёт). Брось деревянный ящик в манекен под полкой.

        // Слои (9.6а): ещё левее, за материалами. Решётка держит героя и обычные ящики,
        // а жук-призрак и призрачный ящик проходят сквозь неё. Подойди к решётке —
        // жук побежит к тебе прямо сквозь прутья. Толкни призрачный ящик в решётку.
        (
            name: "решётка",
            at: (-10.6, -0.18),
            depth: 2,
            layer: "решётка",
            shapes: [
                Rect(at: (0.0, 0.0), size: (0.06, 1.2), color: "#5a6a7a", solid: true),
                Rect(at: (-0.06, 0.0), size: (0.015, 1.2), color: "#3a4450"),
                Rect(at: (0.06, 0.0), size: (0.015, 1.2), color: "#3a4450"),
            ],
        ),
        (
            name: "жук-призрак",
            at: (-11.0, -0.7),
            depth: 2,
            opacity: 0.6,
            layer: "призрак",
            dummy: (size: (0.2, 0.12), hp: 3, respawn: 3.0, contact: 1),
            script: "scripts/beetle.luau",
            shapes: [
                Rect(at: (-0.01, 0.0), size: (0.18, 0.1), corner: 0.05, color: "#8ab4e0"),
                Circle(at: (0.085, -0.01), r: 0.035, color: "#6a8ab0"),
                Circle(at: (0.1, 0.0), r: 0.009, color: "#ffffff"),
            ],
        ),
        (
            name: "призрачный ящик",
            at: (-10.2, -0.72),
            depth: 2,
            opacity: 0.6,
            layer: "призрак",
            body: (size: (0.12, 0.12), friction: 0.3),
            shapes: [Rect(at: (0.0, 0.0), size: (0.12, 0.12), corner: 0.008, color: "#a0c4f0")],
        ),
        (
            name: "обычный ящик у решётки",
            at: (-10.4, -0.72),
            depth: 2,
            body: (size: (0.12, 0.12), friction: 0.3),
            shapes: [Rect(at: (0.0, 0.0), size: (0.12, 0.12), corner: 0.008, color: "#b87a40")],
        ),

        // Зоны (9.6б): невидимые области с полем сил; здесь они чуть подсвечены.
        // zone: (size: (ширина, высота), wind: (x, y) — ветер или течение, gravity —
        // во сколько раз тяжесть, magnet — тянет железо к середине). Герой, входя и
        // выходя, получает событие (видно в консоли ~, «события»).
        (
            // Слева от героя: тяжесть втрое слабее — прыжок выше и дольше.
            name: "лёгкая тяжесть",
            at: (-1.85, -0.1),
            depth: 1,
            opacity: 0.12,
            zone: (size: (0.7, 1.4), gravity: 0.35),
            shapes: [Rect(at: (0.0, 0.0), size: (0.7, 1.4), color: "#6ad0ff")],
        ),
        (
            // Над мельницей: ветер сносит левую часть дождя.
            name: "ветер",
            at: (9.4, 0.5),
            depth: 1,
            opacity: 0.1,
            zone: (size: (0.8, 0.6), wind: (-1.5, 0.0)),
            shapes: [Rect(at: (0.0, 0.0), size: (0.8, 0.6), color: "#e0f0ff")],
        ),
        (
            // Магнит держит железный брусок в воздухе; брось в него другое железо.
            name: "магнит",
            at: (-7.55, -0.35),
            depth: 1,
            opacity: 0.12,
            zone: (size: (0.45, 0.9), magnet: 12.0),
            shapes: [Rect(at: (0.0, 0.0), size: (0.45, 0.9), color: "#ff8080")],
        ),

        // Пирамида: 20 рядов, 210 кубиков. Rapier держит её, но кубики чуть
        // проседают друг в друга (около 3 см за первую секунду), потом стоят и засыпают.
        // Каменную плиту (9.6в) герой берёт за край (C или E) и тянет волоком, сам идёт
        // медленнее; C, E или прыжок отпускают.
        (
            name: "каменная плита",
            at: (-0.85, -0.68),
            depth: 2,
            body: (size: (0.26, 0.2), material: Stone),
            shapes: [Rect(at: (0.0, 0.0), size: (0.26, 0.2), corner: 0.015, color: "#8a857c"), Rect(at: (0.0, 0.0), size: (0.26, 0.2), color: "#5c5852", stroke: 0.01)],
        ),
        (
            name: "кубик",
            at: (-0.4, -0.745),
            depth: 2,
            body: (size: (0.07, 0.07), density: 1.0, friction: 0.7),
            shapes: [Rect(at: (0.0, 0.0), size: (0.07, 0.07), corner: 0.008, color: "#d9a05b")],
            repeat: (
                count: 20, step: (0.0705, 0.0), rows: 20, row_step: (0.0, 0.0702), shrink: 1,
                colors: ["#d9a05b", "#c98a48", "#e0b070", "#b87a40", "#e8c088"],
            ),
        ),

        // Маятник: шар на верёвке к миру; отпущен сбоку и бьёт по домино.
        (
            name: "биток",
            at: (1.45, -0.35),
            depth: 2,
            body: (size: (0.12, 0.12), round: true, density: 4.0, bounce: 0.2),
            shapes: [Circle(at: (0.0, 0.0), r: 0.06, color: "#6a7280"), Circle(at: (-0.02, 0.02), r: 0.018, color: "#a8b0bc")],
            joints: [(kind: Rope, to: World, to_at: (0.4, 0.4), line: (width: 0.006, color: "#c8b48a"))],
        ),
        (
            name: "домино",
            at: (1.93, -0.66),
            depth: 2,
            body: (size: (0.03, 0.24), density: 1.0, friction: 0.5),
