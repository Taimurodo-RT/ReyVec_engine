// Сцена-нагрузка физики (9.7): 2 000 тел и уровень. Слева направо: стена из 500
// ящиков, пирамида из 820 кубиков, герой, корзина с 300 шарами и куча из 380
// капсул и камней, которая падает сверху в начале.
//
// Что смотреть: на панели (F1) строка физики — сколько тел, сколько из них спят и
// сколько миллисекунд занял шаг физики; строка логики — весь шаг. Цели: шаг физики
// до 4 мс, весь шаг логики до 6 мс. Сначала всё падает и толкается (дорого), потом
// засыпает (дёшево). Y — взрыв под курсором будит тела, Q — тащить тело мышью.
// N — следующий файл сцены из папки scenes.
(
    format: "reyvec-scene",
    version: 1,
    background: Lab,
    ambient: "#565c68",
    lights: [
        Sun(from: (0.5, 1.0), color: "#fff0d8", power: 0.8, reach: 0.5, size: 0.04),
    ],
    nodes: [
        (
            name: "герой",
            at: (0.2, -0.5),
            depth: 3,
            shadow: true,
            player: (size: (0.14, 0.28), speed: 1.6, jump: 0.6, jump_time: 0.36, hp: 5),
            shapes: [
                Rect(at: (0.0, -0.02), size: (0.12, 0.2), corner: 0.04, color: "#3b5f8a"),
                Circle(at: (0.0, 0.09), r: 0.05, color: "#e8c9a0"),
            ],
        ),
        (
            name: "границы",
            solids: [
                (at: (0.0, -0.88), size: (14.0, 0.2)),
                (at: (-6.9, 1.2), size: (0.2, 4.4)),
                (at: (6.9, 1.2), size: (0.2, 4.4)),
                // Стенки корзины для шаров.
                (at: (1.0, -0.48), size: (0.06, 0.6)),
                (at: (2.6, -0.48), size: (0.06, 0.6)),
            ],
            shapes: [
                Rect(at: (0.0, -0.88), size: (14.0, 0.2), color: "#3a3f4a"),
                Rect(at: (-6.9, 1.2), size: (0.2, 4.4), color: "#3a3f4a"),
                Rect(at: (6.9, 1.2), size: (0.2, 4.4), color: "#3a3f4a"),
                Rect(at: (1.0, -0.48), size: (0.06, 0.6), color: "#5a6070"),
                Rect(at: (2.6, -0.48), size: (0.06, 0.6), color: "#5a6070"),
            ],
        ),
        (
            // Стена из ящиков: 25 в ряд, 20 рядов.
            name: "ящик",
            at: (-6.4, -0.75),
            depth: 2,
            body: (size: (0.06, 0.06), material: Wood),
            shapes: [Rect(at: (0.0, 0.0), size: (0.06, 0.06), corner: 0.006, color: "#b87a40")],
            repeat: (
                count: 25, step: (0.0605, 0.0), rows: 20, row_step: (0.0, 0.0602),
                colors: ["#b87a40", "#a86c38", "#c88a50"],
            ),
        ),
        (
            // Пирамида: 40 рядов, каждый на кубик короче.
            name: "кубик",
            at: (-4.0, -0.755),
            depth: 2,
            body: (size: (0.05, 0.05), density: 1.0, friction: 0.7),
            shapes: [Rect(at: (0.0, 0.0), size: (0.05, 0.05), corner: 0.006, color: "#d9a05b")],
            repeat: (
                count: 40, step: (0.0505, 0.0), rows: 40, row_step: (0.0, 0.0502), shrink: 1,
                colors: ["#d9a05b", "#c98a48", "#e0b070", "#e8c088"],
            ),
        ),
        (
            // Шары падают в корзину: 20 в ряд, 15 рядов.
            name: "шар",
            at: (1.1, 0.2),
            depth: 2,
            body: (size: (0.07, 0.07), round: true, material: Rubber),
            shapes: [Circle(at: (0.0, 0.0), r: 0.035, color: "#d9534f")],
            repeat: (
                count: 20, step: (0.072, 0.0), rows: 15, row_step: (0.005, 0.075),
                colors: ["#d9534f", "#e07a5f", "#c0392b", "#f2a65a"],
            ),
        ),
        (
            // Капсулы и камни падают кучей справа: по 20 в ряд, 10 и 9 рядов.
            name: "капсула",
            at: (3.2, 0.3),
            depth: 2,
            body: (size: (0.04, 0.12), capsule: true, density: 1.0),
            shapes: [Rect(at: (0.0, 0.0), size: (0.04, 0.12), corner: 0.02, color: "#6a9fd8")],
            repeat: (
                count: 20, step: (0.15, 0.0), rows: 10, row_step: (0.03, 0.16),
                colors: ["#6a9fd8", "#5a8fc8", "#8ab4e0"],
            ),
        ),
        (
            name: "камень",
            at: (3.27, 0.38),
            depth: 2,
            body: (points: [(-0.04, -0.03), (0.035, -0.035), (0.045, 0.01), (0.0, 0.04), (-0.04, 0.02)], material: Stone),
            shapes: [Polygon(points: [(-0.04, -0.03), (0.035, -0.035), (0.045, 0.01), (0.0, 0.04), (-0.04, 0.02)], color: "#7b7770")],
            repeat: (
                count: 20, step: (0.15, 0.0), rows: 9, row_step: (0.03, 0.16),
                colors: ["#7b7770", "#8a857c", "#6a665f"],
            ),
        ),
    ],
)
