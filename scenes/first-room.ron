// Сцена «первая комната» (этап 5.1). Открой этот файл в блокноте, поменяй число или
// цвет и сохрани: окно песочницы (клавиша N) сразу покажет новую сцену. Если ошибёшься,
// в заголовке окна и на панели будет строка и что не так, а сцена останется прежней.
//
// Координаты: x вправо, y вверх. Кадр по высоте от -1 (низ) до 1 (верх), по ширине
// на мониторе 16:9 примерно от -1.78 до 1.78. Углы (angle) в градусах против часовой.
// Цвета как в редакторах: "#rrggbb" или "#rrggbbaa" (последние две цифры — прозрачность).
// Всё после // до конца строки — комментарий, движок его не читает.
(
    format: "reyvec-scene",
    version: 1,

    // Фон: Lab (каменная стена и дощатый пол) или Plain (светло-серый пол).
    background: Lab,
    // Общий тусклый свет, который есть везде, даже в тени.
    ambient: "#3c4048",

    // Слои векторных фигур, снизу вверх. shadow: true — фигуры слоя отбрасывают тень.
    // Фигуры: Rect (прямоугольник), Circle (круг), Polygon (многоугольник),
    // Line (ломаная линия), Path (контур в записи SVG). У любой фигуры можно задать
    // stroke: толщина — тогда рисуется только контур.
    layers: [
        (
            name: "стол и вещи",
            shadow: true,
            shapes: [
                // Столешница и ножки.
                Rect(at: (-0.6, -0.42), size: (1.5, 0.05), corner: 0.01, color: "#764c2e"),
                Rect(at: (-1.25, -0.6), size: (0.05, 0.35), color: "#54341f"),
                Rect(at: (0.05, -0.6), size: (0.05, 0.35), color: "#54341f"),
                // Три банки с крышками.
                Rect(at: (-1.1, -0.29), size: (0.14, 0.22), corner: 0.03, color: "#4f7a5a"),
                Rect(at: (-1.1, -0.17), size: (0.12, 0.03), color: "#5c4028"),
                Rect(at: (-0.88, -0.32), size: (0.12, 0.15), corner: 0.03, color: "#8a5a8f"),
                Rect(at: (-0.88, -0.235), size: (0.10, 0.025), color: "#5c4028"),
                Rect(at: (-0.68, -0.27), size: (0.10, 0.25), corner: 0.03, color: "#c08a3a"),
                Rect(at: (-0.68, -0.135), size: (0.085, 0.025), color: "#5c4028"),
                // Стопка книг, верхняя чуть повёрнута.
                Rect(at: (-0.25, -0.375), size: (0.32, 0.045), color: "#7a2f2f"),
                Rect(at: (-0.24, -0.33), size: (0.28, 0.045), color: "#2f4f7a"),
                Rect(at: (-0.26, -0.285), size: (0.26, 0.04), angle: 4.0, color: "#3f6b3a"),
                // Подставка для шара (многоугольник по точкам относительно at).
                Polygon(
                    at: (-0.25, -0.265),
                    points: [(-0.07, 0.0), (0.07, 0.0), (0.04, 0.03), (0.03, 0.05), (-0.03, 0.05), (-0.04, 0.03)],
                    color: "#b07c3a",
                ),
            ],
        ),
        (
            name: "полка",
            shadow: true,
            shapes: [
                Rect(at: (1.1, 0.2), size: (0.9, 0.04), color: "#764c2e"),
                Polygon(at: (0.72, 0.18), points: [(0.0, 0.0), (0.12, 0.0), (0.0, -0.12)], color: "#54341f"),
                Polygon(at: (1.48, 0.18), points: [(0.0, 0.0), (-0.12, 0.0), (0.0, -0.12)], color: "#54341f"),
                // Горшок с листьями (контур в записи SVG, но y вверх).
                Rect(at: (0.85, 0.28), size: (0.14, 0.12), corner: 0.02, color: "#a0522d"),
                Path(
                    at: (0.85, 0.34),
                    svg: "M 0 0 Q -0.12 0.08 -0.1 0.2 Q -0.02 0.12 0 0 Q 0.02 0.16 0.1 0.22 Q 0.12 0.08 0 0 Z",
                    color: "#4c8a3c",
                ),
                // Часы: круг с контуром и стрелками-линиями.
                Circle(at: (1.3, 0.34), r: 0.1, color: "#e8dcc0"),
                Circle(at: (1.3, 0.34), r: 0.1, color: "#5c4028", stroke: 0.015),
                Line(at: (1.3, 0.34), points: [(0.0, 0.0), (0.0, 0.07)], width: 0.012, color: "#202020"),
                Line(at: (1.3, 0.34), points: [(0.0, 0.0), (0.05, -0.02)], width: 0.012, color: "#202020"),
            ],
        ),
        (
            name: "рамка окна (без тени)",
            shapes: [
                Rect(at: (0.25, 0.5), size: (0.5, 0.4), color: "#2a2f3a", stroke: 0.03),
                Line(points: [(0.25, 0.3), (0.25, 0.7)], width: 0.02, color: "#2a2f3a"),
            ],
        ),
    ],

    // Источники света (до 16). Point — лампа, Tube — светящаяся трубка, Sun — свет
    // издалека. power — яркость, reach — докуда достаёт свет (у Sun — длина теней),
    // size — размер источника: чем больше, тем мягче края теней.
    lights: [
        Point(at: (-0.5, 0.45), color: "#ffcf8a", power: 2.2, reach: 2.2, size: 0.04),
        Tube(from: (0.75, 0.13), to: (1.45, 0.13), color: "#ff5ab4", power: 1.2, reach: 0.9, size: 0.01),
        Sun(from: (-0.4, 1.0), color: "#8aa8ff", power: 0.35, reach: 1.5, size: 0.05),
        Point(at: (-0.25, -0.13), color: "#6affc0", power: 1.0, reach: 0.8, size: 0.03),
    ],

    // Объекты из SDF (до 16): части (Circle, Capsule) сливаются плавно, как капли.
    // blend — размер перемычки между частями, glow: true — светится сам,
    // shadow: true — отбрасывает тень.
    objects: [
        (
            name: "магический шар",
            parts: [Circle(at: (-0.25, -0.15), r: 0.075)],
            color: "#5affb8",
            power: 2.5,
            glow: true,
        ),
        (
            name: "лужа слизи",
            parts: [
                Capsule(from: (0.5, -0.83), to: (0.85, -0.83), r: 0.035),
                Circle(at: (0.62, -0.78), r: 0.05),
                Circle(at: (0.76, -0.79), r: 0.035),
            ],
            blend: 0.06,
            color: "#7bd34a",
            shadow: true,
        ),
        (
            name: "неоновая лента",
            parts: [Capsule(from: (0.75, 0.13), to: (1.45, 0.13), r: 0.008)],
            color: "#ff5ab4",
            power: 3.0,
            glow: true,
        ),
    ],
)
