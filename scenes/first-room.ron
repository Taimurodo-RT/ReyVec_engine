// Сцена «первая комната» (этап 5). Открой этот файл в блокноте, поменяй число или
// цвет и сохрани: окно песочницы (клавиша N) сразу покажет новую сцену. Если ошибёшься,
// в заголовке окна и на панели будет строка и что не так, а сцена останется прежней.
//
// Координаты: x вправо, y вверх. Кадр по высоте от -1 (низ) до 1 (верх), по ширине
// на мониторе 16:9 примерно от -1.78 до 1.78. Углы (angle) в градусах против часовой.
// Цвета как в редакторах: "#rrggbb" или "#rrggbbaa" (последние две цифры — прозрачность).
// Всё после // до конца строки — комментарий, движок его не читает.
(
    format: "reyvec-scene",
    version: 1,

    // Фон: Lab (каменная стена и дощатый пол) или Plain (светло-серый пол).
    background: Lab,
    // Общий тусклый свет, который есть везде, даже в тени.
    ambient: "#3c4048",

    // Предметы сцены. У предмета:
    //   at — место, angle — поворот, scale — размер, depth — глубина (больше — ближе,
    //   рисуется поверх), shadow: true — его фигуры отбрасывают тень, opacity — прозрачность;
    //   shapes — фигуры, lights — источники света, objects — SDF-объекты,
    //   children — вложенные предметы.
    // Движение: spin — вращение (градусов в секунду, минус — по часовой),
    //   swing: (angle: размах в градусах, period: секунд на взмах) — качание, как маятник,
    //   bob: (by: (x, y), period: секунд) — покачивание туда-обратно.
    //   Движение считает логика игры 60 раз в секунду, а окно плавно дорисовывает его
    //   между шагами.
    // Всё внутри предмета записано относительно его места: сдвинь at у стола, и банки,
    // книги, шар и его свет поедут вместе со столом. Вложенный предмет берёт тень,
    // прозрачность и глубину у родителя (глубины складываются).
    //
    // Фигуры: Rect (прямоугольник), Circle (круг), Polygon (многоугольник по точкам),
    // Line (ломаная линия), Path (контур в записи SVG, но y вверх). У любой фигуры
    // можно задать stroke: толщина — тогда рисуется только контур.
    //
    // Рисунки из файлов (путь — от папки этого файла сцены):
    //   pictures: [(svg: "путь.svg", at: (x, y), height: высота, angle: поворот)]
    //   morphs: [(motif: "путь.reyvec.json", shape: "имя фигуры", at, scale, angle,
    //             animation: "имя анимации", color: "#rrggbb")] — перетекающая фигура из
    //   редактора Motif; без animation играет первая анимация фигуры.
    // Сохранишь сцену — рисунки берутся готовыми; поменял сам рисунок — сохрани сцену,
    // и он перечитается.
    nodes: [
        (
            name: "стол",
            at: (-0.6, -0.42),
            depth: 1,
            shadow: true,
            shapes: [
                // Столешница и ножки.
                Rect(at: (0.0, 0.0), size: (1.5, 0.05), corner: 0.01, color: "#764c2e"),
                Rect(at: (-0.65, -0.18), size: (0.05, 0.35), color: "#54341f"),
                Rect(at: (0.65, -0.18), size: (0.05, 0.35), color: "#54341f"),
                // Три банки с крышками.
                Rect(at: (-0.5, 0.13), size: (0.14, 0.22), corner: 0.03, color: "#4f7a5a"),
                Rect(at: (-0.5, 0.25), size: (0.12, 0.03), color: "#5c4028"),
                Rect(at: (-0.28, 0.10), size: (0.12, 0.15), corner: 0.03, color: "#8a5a8f"),
                Rect(at: (-0.28, 0.185), size: (0.10, 0.025), color: "#5c4028"),
                Rect(at: (-0.08, 0.15), size: (0.10, 0.25), corner: 0.03, color: "#c08a3a"),
                Rect(at: (-0.08, 0.285), size: (0.085, 0.025), color: "#5c4028"),
            ],
            children: [
                (
                    name: "книги",
                    at: (0.35, 0.045),
                    shapes: [
                        Rect(at: (0.0, 0.0), size: (0.32, 0.045), color: "#7a2f2f"),
                        Rect(at: (0.01, 0.045), size: (0.28, 0.045), color: "#2f4f7a"),
                        // Верхняя книга чуть повёрнута.
                        Rect(at: (-0.01, 0.09), size: (0.26, 0.04), angle: 4, color: "#3f6b3a"),
                    ],
                    children: [
                        (
                            // Магический шар на подставке стоит на книгах.
                            name: "шар",
                            at: (0.0, 0.11),
                            shapes: [
                                Polygon(
                                    points: [(-0.07, 0.0), (0.07, 0.0), (0.04, 0.03), (0.03, 0.05), (-0.03, 0.05), (-0.04, 0.03)],
                                    color: "#b07c3a",
                                ),
                            ],
                            children: [
                                (
                                    // Сфера чуть парит над подставкой вместе со своим светом.
                                    name: "сфера",
                                    bob: (by: (0.0, 0.012), period: 3.0),
                                    lights: [
                                        Point(at: (0.0, 0.135), color: "#6affc0", power: 1.0, reach: 0.8, size: 0.03),
                                    ],
                                    objects: [
                                        (parts: [Circle(at: (0.0, 0.115), r: 0.075)], color: "#5affb8", power: 2.5, glow: true),
                                    ],
                                ),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (
            name: "полка",
            at: (1.1, 0.2),
            depth: 1,
            shadow: true,
            shapes: [
                Rect(at: (0.0, 0.0), size: (0.9, 0.04), color: "#764c2e"),
                Polygon(at: (-0.38, -0.02), points: [(0.0, 0.0), (0.12, 0.0), (0.0, -0.12)], color: "#54341f"),
                Polygon(at: (0.38, -0.02), points: [(0.0, 0.0), (-0.12, 0.0), (0.0, -0.12)], color: "#54341f"),
                // Горшок с листьями.
                Rect(at: (-0.25, 0.08), size: (0.14, 0.12), corner: 0.02, color: "#a0522d"),
                Path(
                    at: (-0.25, 0.14),
                    svg: "M 0 0 Q -0.12 0.08 -0.1 0.2 Q -0.02 0.12 0 0 Q 0.02 0.16 0.1 0.22 Q 0.12 0.08 0 0 Z",
                    color: "#4c8a3c",
                ),
            ],
            // Розовая неоновая лента под полкой: светит (Tube) и сама видна (объект).
            lights: [
                Tube(from: (-0.35, -0.07), to: (0.35, -0.07), color: "#ff5ab4", power: 1.2, reach: 0.9, size: 0.01),
            ],
            objects: [
                (parts: [Capsule(from: (-0.35, -0.07), to: (0.35, -0.07), r: 0.008)], color: "#ff5ab4", power: 3.0, glow: true),
            ],
            children: [
                (
                    // Фото в рамке на полке: рисунок SVG из файла.
                    name: "фото",
                    at: (-0.035, 0.115),
                    pictures: [
                        (svg: "../assets/svg/illustration.svg", height: 0.17),
                    ],
                    shapes: [
                        Rect(at: (0.0, 0.0), size: (0.235, 0.18), color: "#3a2a1c", stroke: 0.012),
                    ],
                ),
                (
                    name: "часы",
                    at: (0.2, 0.14),
                    shapes: [
                        Circle(at: (0.0, 0.0), r: 0.1, color: "#e8dcc0"),
                        Circle(at: (0.0, 0.0), r: 0.1, color: "#5c4028", stroke: 0.015),
                    ],
                    children: [
                        // Стрелки идут быстро, чтобы движение было видно сразу.
                        (name: "большая стрелка", spin: -36, shapes: [
                            Line(points: [(0.0, 0.0), (0.0, 0.07)], width: 0.012, color: "#202020"),
                        ]),
                        (name: "малая стрелка", spin: -3, angle: -68, shapes: [
                            Line(points: [(0.0, 0.0), (0.0, 0.05)], width: 0.012, color: "#202020"),
                        ]),
                    ],
                ),
            ],
        ),
        (
            // Рамка окна без тени (shadow не задан — у корня тени нет).
            name: "окно",
            at: (0.25, 0.5),
            shapes: [
                Rect(at: (0.0, 0.0), size: (0.5, 0.4), color: "#2a2f3a", stroke: 0.03),
                Line(points: [(0.0, -0.2), (0.0, 0.2)], width: 0.02, color: "#2a2f3a"),
            ],
            children: [
                (
                    // За окном переливается клякса из редактора Motif (глубже рамки —
                    // рисуется под ней).
                    name: "клякса",
                    depth: -0.5,
                    morphs: [
                        (motif: "../assets/motif/morph.reyvec.json", shape: "blob", scale: 0.17, at: (0.0, -0.01)),
                    ],
                ),
            ],
        ),
        (
            // Лампа на шнуре качается, как маятник: точка подвеса у потолка, тени
            // от стола и полки качаются вместе с ней.
            name: "лампа",
            at: (-0.5, 1.0),
            depth: 2,
            swing: (angle: 12, period: 3.2),
            shapes: [
                Line(points: [(0.0, 0.0), (0.0, -0.5)], width: 0.008, color: "#202020"),
                Polygon(
                    at: (0.0, -0.5),
                    points: [(-0.07, -0.045), (0.07, -0.045), (0.025, 0.0), (-0.025, 0.0)],
                    color: "#3a3a40",
                ),
            ],
            lights: [
                Point(at: (0.0, -0.565), color: "#ffcf8a", power: 2.2, reach: 2.2, size: 0.04),
            ],
        ),
        (
            name: "лужа слизи",
            at: (0.67, -0.81),
            objects: [
                (
                    parts: [
                        Capsule(from: (-0.17, -0.02), to: (0.18, -0.02), r: 0.035),
                        Circle(at: (-0.05, 0.03), r: 0.05),
                        Circle(at: (0.09, 0.02), r: 0.035),
                    ],
                    blend: 0.06,
                    color: "#7bd34a",
                    shadow: true,
                ),
            ],
        ),
    ],

    // Источники света всей комнаты (до 16 на сцену вместе с источниками в предметах).
    // Лампа — в предмете «лампа» выше: она качается.
    // Point — лампа, Tube — светящаяся трубка, Sun — свет издалека. power — яркость,
    // reach — докуда достаёт свет (у Sun — длина теней), size — размер источника: чем
    // больше, тем мягче края теней.
    lights: [
        Sun(from: (-0.4, 1.0), color: "#8aa8ff", power: 0.35, reach: 1.5, size: 0.05),
    ],
)
