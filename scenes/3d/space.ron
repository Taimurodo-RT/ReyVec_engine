// Объёмная сцена «3D» (этап 7, клавиша I в песочнице). Открой этот файл в блокноте,
// поменяй число или цвет и сохрани: окно сразу покажет новую сцену. Если ошибёшься,
// на панели будет строка, что не так, а в окне останется прошлая сцена.
//
// Координаты в метрах: x вправо, y вверх, z к зрителю (камера по умолчанию смотрит
// из точки (6, 4, 9) в середину сцены). Пол — плоскость y = 0.
// Углы (turn) — градусы вокруг X, потом Y, потом Z.
// Цвета: "#rrggbb", как в редакторах, или три числа от 0 до 1, например (0.85, 0.35, 0.2).
// Всё после // до конца строки — комментарий, движок его не читает.
// culling: false (рядом с version) выключает сетку отсева — только для замеров скорости.
// view_culling: false — отсев по взгляду (только видимое и его тени), тоже для замеров.
// compute: true — лучи глаза вычислительным шейдером (опыт 7.6м), для замеров.
// camera: Some((eye: (x, y, z), look_at: (x, y, z))) — откуда камера смотрит при открытии
// файла и по R.
(
    format: "reyvec-space",
    version: 1,

    // Материалы: имя, цвет, glow — свечение (своя яркость: не темнеет в тени, больше 1 —
    // ореол при включённом свечении, клавиша B), grid: true — сетка на поверхности.
    materials: [
        (name: "пол", color: (0.18, 0.19, 0.21), grid: true),
        (name: "оранжевый", color: (0.85, 0.35, 0.20)),
        (name: "синий", color: (0.25, 0.55, 0.85)),
        (name: "золото", color: (0.90, 0.75, 0.25)),
        (name: "слизь", color: (0.30, 0.80, 0.35)),
        (name: "камень", color: (0.70, 0.68, 0.64)),
    ],

    // Лампы: at — где, color — цвет света, power — яркость на расстоянии 1 м,
    // range — дальше этого лампа не светит (свет плавно гаснет к границе),
    // bulb — радиус светящегося шарика на месте лампы (0 — без шарика).
    // Тени отбрасывают первые две лампы, остальные светят без теней.
    // Движение (у ламп и предметов, можно не писать):
    //   bob: (by: (x, y, z), period: секунд) — покачивание туда-обратно на by;
    //   circle: (radius: (по x, по z), period: секунд на круг) — по кругу или овалу.
    lamps: [
        // Тёплая лампа кружит над слизью.
        (at: (0.0, 1.5, 3.0), color: (1.0, 0.62, 0.30), power: 6.0, range: 6.0, bulb: 0.09,
            circle: (radius: (1.3, 1.0), period: 8.975979)),
        // Холодная висит между кубиками.
        (at: (2.4, 1.9, 1.1), color: (0.35, 0.65, 1.0), power: 5.0, range: 5.0, bulb: 0.09),
    ],

    // Предметы: name — имя (для сообщений об ошибках), material — имя материала,
    // at — место, turn — поворот, shape — форма. Кроме bob и circle у предмета есть
    // spin: (x, y, z) — вращение, градусов в секунду вокруг каждой оси.
    //
    // Формы:
    //   Sphere(radius) — шар; Box(size: (ширина, высота, глубина), round) — коробка со
    //   скруглёнными краями; Capsule(height, radius) — капсула вдоль Y;
    //   Cylinder(height, radius, round) — цилиндр вдоль Y; Torus(radius, thickness) —
    //   бублик лёжа; Plane(normal, offset) — бесконечная плоскость.
    //   Union(shapes: [...], smooth) — объединить (smooth — ширина плавного перехода:
    //   формы сливаются, как капли), Subtract(base: форма, cut: [...], smooth) — вырезать,
    //   Intersect(shapes: [...], smooth) — оставить общее.
    //   Move(at, turn, scale, shape) — сдвинуть часть формы.
    //   Animate(bob, circle, spin, shape) — двигать часть формы (как у предмета).
    // Середина каждой формы — в начале её координат: шар радиусом 1 на полу ставится
    // в at: (0, 1, 0).
    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        (name: "шар", material: "оранжевый", at: (0.0, 1.0, 0.0), shape: Sphere(radius: 1.0),
            bob: (by: (0.0, 0.15, 0.0), period: 4.833219)),
        (name: "коробка", material: "синий", at: (3.0, 0.75, -0.5),
            shape: Box(size: (1.5, 1.5, 1.5), round: 0.08)),
        // Тор стоит на ребре и медленно крутится вокруг вертикали.
        (name: "тор", material: "золото", at: (-3.2, 1.0, 0.3), turn: (90.0, 0.0, 0.0),
            shape: Torus(radius: 0.75, thickness: 0.25),
            spin: (0.0, 28.64789, 0.0)),
        // Капля бегает туда-сюда между двумя шарами слизи и плавно сливается с ними.
        (name: "слизь", material: "слизь", shape: Union(smooth: 0.45, shapes: [
            Move(at: (-1.4, 0.55, 3.0), shape: Sphere(radius: 0.55)),
            Move(at: (1.4, 0.55, 3.0), shape: Sphere(radius: 0.55)),
            Animate(bob: (by: (1.1, 0.0, 0.0), period: 6.981317),
                shape: Move(at: (0.0, 0.45, 3.0), shape: Sphere(radius: 0.32))),
            // Лужица, на которой они стоят.
            Move(at: (0.0, 0.03, 3.0), shape: Cylinder(height: 0.06, radius: 1.9, round: 0.03)),
        ])),
        // Коробка с вырезанным шаром медленно крутится.
        (name: "коробка с дырами", material: "синий", at: (3.4, 0.6, 2.6),
            shape: Subtract(base: Box(size: (1.2, 1.2, 1.2), round: 0.04),
                cut: [Sphere(radius: 0.78)], smooth: 0.05),
            spin: (0.0, 17.188734, 0.0)),
        // Колонна: цилиндр и две плиты.
        (name: "колонна", material: "камень", at: (-1.5, 0.0, -3.0), shape: Union(smooth: 0.15, shapes: [
            Move(at: (0.0, 1.5, 0.0), shape: Cylinder(height: 3.0, radius: 0.3, round: 0.02)),
            Move(at: (0.0, 0.1, 0.0), shape: Box(size: (1.0, 0.2, 1.0), round: 0.03)),
            Move(at: (0.0, 3.0, 0.0), shape: Box(size: (0.9, 0.2, 0.9), round: 0.03)),
        ])),
    ],
)
