// Наковальня (М.0б): лицо, перехват, основание, лапы зеркалом, рог — конус.
// Высота 0,46 м, начало координат — середина низа лап. Своя работа, CC0.
(
    format: "reyvec-shape",
    version: 1,
    materials: [
        (name: "железо", color: "#3b3e44"),
    ],
    shape: Paint(material: 0, shape: Union(smooth: 0.02, shapes: [
        // Лапы: одна записана, вторая — её отражение через плоскость YZ.
        Mirror(axis: X, shape: Move(at: (0.14, 0.025, 0.0),
            shape: Box(size: (0.10, 0.05, 0.26), round: 0.01))),
        Move(at: (0.0, 0.08, 0.0), shape: Box(size: (0.38, 0.06, 0.20), round: 0.01)),
        Move(at: (0.0, 0.23, 0.0), shape: Box(size: (0.20, 0.24, 0.12), round: 0.01)),
        // Лицо и пятка.
        Move(at: (0.0, 0.405, 0.0), shape: Box(size: (0.50, 0.11, 0.16), round: 0.01)),
        Move(at: (-0.29, 0.42, 0.0), shape: Box(size: (0.10, 0.08, 0.12), round: 0.01)),
        // Рог: конус вдоль Y, повёрнут остриём в +X.
        Move(at: (0.36, 0.42, 0.0), turn: (0.0, 0.0, -90.0),
            shape: Cone(height: 0.26, bottom: 0.055, top: 0.008, round: 0.004)),
    ])),
)
