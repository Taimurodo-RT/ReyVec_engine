// Смешанная сцена (опыт совмещения, этап 7.6ж): формы SDF и полигональные модели в одном
// кадре. Запуск:
//     .\run.bat --space-file scenes\3d\mixed.ron
// потом клавиша I.
//
// Что смотреть:
// - полигональные модели (гранёные, с плоскими гранями) и гладкие формы SDF стоят рядом
//   и протыкают друг друга: кристалл торчит из капли слизи, куб наполовину в шаре;
// - тени общие: модель бросает тень на формы SDF и на пол, а формы — на модель;
// - лампы светят на всё одинаково.
// У модели shadow: false убирает её тень (для сравнения).
// Файл правится на лету, как space.ron. Формы SDF описаны там же, в space.ron.
// Модели (meshes): Icosphere(radius, detail) — шар из треугольников (detail 0…3,
// больше — глаже), Block(size: (ширина, высота, глубина)) — коробка,
// Crystal(radius, height, sides) — кристалл из двух пирамид.
(
    format: "reyvec-space",
    version: 1,

    materials: [
        (name: "пол", color: (0.18, 0.19, 0.21), grid: true),
        (name: "слизь", color: (0.30, 0.80, 0.35)),
        (name: "оранжевый", color: (0.85, 0.35, 0.20)),
        (name: "синий", color: (0.25, 0.55, 0.85)),
        (name: "кристалл", color: "#b48cf0"),
        (name: "камень", color: (0.70, 0.68, 0.64)),
        (name: "золото", color: (0.90, 0.75, 0.25)),
    ],

    lamps: [
        (at: (0.0, 1.6, 2.2), color: (1.0, 0.62, 0.30), power: 6.0, range: 6.0, bulb: 0.09,
            circle: (radius: (1.5, 1.0), period: 9.0)),
        (at: (2.6, 2.0, -1.0), color: (0.35, 0.65, 1.0), power: 5.0, range: 5.0, bulb: 0.09),
    ],

    // Формы SDF.
    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        // Капля слизи: в неё воткнут полигональный кристалл.
        (name: "капля", material: "слизь", shape: Union(smooth: 0.4, shapes: [
            Move(at: (-1.6, 0.6, 1.0), shape: Sphere(radius: 0.6)),
            Move(at: (-0.8, 0.4, 1.3), shape: Sphere(radius: 0.4)),
            Move(at: (-1.2, 0.03, 1.1), shape: Cylinder(height: 0.06, radius: 1.3, round: 0.03)),
        ])),
        // Гладкий шар: из него торчит полигональный куб.
        (name: "шар", material: "оранжевый", at: (1.6, 0.9, 0.6), shape: Sphere(radius: 0.9)),
        // Тор катится вокруг полигонального шара.
        (name: "тор", material: "золото", at: (0.2, 0.8, -1.6), turn: (90.0, 0.0, 0.0),
            shape: Torus(radius: 0.75, thickness: 0.2), spin: (0.0, 25.0, 0.0)),
        // Арка из камня: SDF с вырезом, под ней стоит полигональная коробка.
        (name: "арка", material: "камень", at: (-2.6, 1.0, -1.4), shape: Subtract(
            base: Box(size: (1.6, 2.0, 0.5), round: 0.04),
            cut: [Move(at: (0.0, -0.4, 0.0), shape: Box(size: (0.9, 1.4, 1.0), round: 0.0))],
            smooth: 0.03)),
    ],

    // Полигональные модели.
    meshes: [
        // Кристалл в капле: крутится.
        (name: "кристалл", material: "кристалл", at: (-1.6, 1.25, 1.0), turn: (0.0, 0.0, 12.0),
            mesh: Crystal(radius: 0.32, height: 1.4, sides: 6), spin: (0.0, 40.0, 0.0)),
        // Куб наполовину в оранжевом шаре.
        (name: "куб в шаре", material: "синий", at: (1.0, 1.4, 1.0), turn: (35.0, 20.0, 10.0),
            mesh: Block(size: (0.8, 0.8, 0.8))),
        // Гранёный шар внутри тора: икосаэдр без дробления, видно грани.
        (name: "гранёный шар", material: "оранжевый", at: (0.2, 0.8, -1.6),
            mesh: Icosphere(radius: 0.45, detail: 0), spin: (10.0, 30.0, 0.0)),
        // Шар из 320 треугольников — почти гладкий, рядом с настоящим гладким.
        (name: "шар из треугольников", material: "золото", at: (2.9, 0.55, -1.2),
            mesh: Icosphere(radius: 0.55, detail: 2), bob: (by: (0.0, 0.2, 0.0), period: 5.0)),
        // Коробка под аркой.
        (name: "коробка", material: "синий", at: (-2.6, 0.3, -1.4), turn: (0.0, 25.0, 0.0),
            mesh: Block(size: (0.6, 0.6, 0.6))),
        // Висящие кристаллы.
        (name: "кристалл 2", material: "кристалл", at: (0.6, 2.6, 1.6),
            mesh: Crystal(radius: 0.18, height: 0.7, sides: 5),
            spin: (0.0, -60.0, 0.0), bob: (by: (0.0, 0.25, 0.0), period: 3.0)),
        (name: "кристалл 3", material: "кристалл", at: (-0.4, 2.3, -0.4),
            mesh: Crystal(radius: 0.15, height: 0.6, sides: 4),
            spin: (0.0, 80.0, 0.0), bob: (by: (0.0, 0.2, 0.0), period: 3.7)),
    ],
)
