// Зеркала: проба резких отражений (Л1, docs/rays-further.md). Запуск:
//     .\run.bat --space-file scenes\3d\mirrors.ron
// потом клавиша I.
//
// У материала shine — блеск: доля отражения, если смотреть на поверхность прямо
// (0 — матовая, 1 — зеркало). Вскользь отражение сильнее, как у настоящих вещей. На
// панели флажок «Отражения 3D»: выключите и сравните вид и время прохода «отражения 3D».
// rough — шероховатость блеска (Л2): 0 — резкое отражение, 1 — сильно размытое. Флажок
// «Размытые отражения 3D» выключает размытие (отражения везде резкие).
//
// Что смотреть: в зеркальной стене видны шары, тор и пол с сеткой, с тенями; в хромовом
// шаре — вся комната, искажённая; пол чуть блестит и вскользь отражает предметы мягко,
// как натёртый; стальной цилиндр и золотой тор отражают размыто.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (3.6, 1.7, 4.2), look_at: (-0.2, 0.9, -1.2))),

    materials: [
        (name: "пол", color: (0.16, 0.17, 0.19), grid: true, shine: 0.12, rough: 0.35),
        (name: "зеркало", color: (0.80, 0.82, 0.85), shine: 0.92),
        (name: "рама", color: (0.22, 0.18, 0.15)),
        (name: "хром", color: (0.75, 0.75, 0.78), shine: 0.8),
        (name: "лак", color: (0.85, 0.30, 0.15), shine: 0.08),
        (name: "золото", color: (0.95, 0.75, 0.30), shine: 0.55, rough: 0.25),
        (name: "сталь", color: (0.62, 0.64, 0.67), shine: 0.7, rough: 0.4),
        (name: "камень", color: (0.65, 0.63, 0.60)),
        (name: "синий", color: (0.25, 0.50, 0.85)),
    ],

    lamps: [
        (at: (1.5, 2.6, 1.5), color: (1.0, 0.85, 0.65), power: 6.0, range: 7.0, bulb: 0.08),
        (at: (-2.5, 2.2, 2.0), color: (0.55, 0.75, 1.0), power: 4.0, range: 6.0, bulb: 0.08),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        // Зеркальная стена в раме.
        (name: "зеркало", material: "зеркало", at: (0.0, 1.5, -3.0),
            shape: Box(size: (6.0, 2.6, 0.06), round: 0.01)),
        (name: "рама", material: "рама", at: (0.0, 1.5, -3.06),
            shape: Box(size: (6.3, 2.9, 0.08), round: 0.02)),
        (name: "хромовый шар", material: "хром", at: (0.0, 0.8, 0.0), shape: Sphere(radius: 0.8)),
        (name: "лаковый шар", material: "лак", at: (2.2, 0.5, -0.8), shape: Sphere(radius: 0.5)),
        (name: "тор", material: "золото", at: (-2.3, 0.9, -0.5), turn: (90.0, 0.0, 0.0),
            shape: Torus(radius: 0.6, thickness: 0.22), spin: (0.0, 20.0, 0.0)),
        (name: "стальной цилиндр", material: "сталь", at: (-1.0, 0.5, -1.8),
            shape: Cylinder(height: 1.0, radius: 0.45, round: 0.04)),
        (name: "камень", material: "камень", at: (-1.2, 0.4, 1.8),
            shape: Box(size: (0.8, 0.8, 0.8), round: 0.06)),
        (name: "синяя коробка", material: "синий", at: (2.6, 0.6, 1.6), turn: (0.0, 30.0, 0.0),
            shape: Box(size: (0.9, 1.2, 0.9), round: 0.05)),
    ],
)
