// Векторные фигуры в 3D (этап 7.7): плоский контур, как в 2D-слое, выдавлен в толщину
// или повёрнут вокруг оси. Запуск:
//     .\run.bat --space-file scenes\3d\vector.ron
// потом клавиша I.
//
// Что смотреть:
// - звезда, сердце и стрелка — выдавленные контуры; рёбра у сердца скруглены (round);
// - в звезде сквозная круглая дыра: из выдавленной фигуры вырезан обычный цилиндр SDF;
// - ваза, пешка и бублик — тела вращения: контур повёрнут вокруг вертикальной оси;
// - облако позади — тонкий выдавленный контур, как плоский слой 2D-фона в 3D-мире;
// - тени, свет и плавные соединения работают с ними так же, как с шарами и коробками.
//
// Как записывать:
//   Extrude(profile: "контур", depth: толщина, round: скругление рёбер)
//   Revolve(profile: "контур", offset: отступ контура от оси)
// Контур — как атрибут d в SVG (M, L, H, V, Q, C, A, Z), только в метрах и Y вверх.
// У выдавливания контур лежит в плоскости XY, толщина по Z. У вращения X — расстояние
// от оси, Y — высота. Контур один раз превращается в сетку расстояний до 64×64 точек,
// поэтому детали меньше 1/60 размера фигуры скругляются.
// Файл правится на лету, как space.ron.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (0.4, 2.3, 6.0), look_at: (0.0, 0.8, 0.0))),

    materials: [
        (name: "пол", color: (0.18, 0.19, 0.21), grid: true),
        (name: "золото", color: (0.90, 0.75, 0.25)),
        (name: "красный", color: (0.85, 0.15, 0.20)),
        (name: "керамика", color: (0.25, 0.55, 0.85)),
        (name: "камень", color: (0.70, 0.68, 0.64)),
        (name: "оранжевый", color: (0.85, 0.40, 0.15)),
        (name: "дерево", color: (0.45, 0.30, 0.18)),
        (name: "облако", color: (0.85, 0.88, 0.95)),
    ],

    lamps: [
        (at: (-1.0, 2.4, 2.0), color: (1.0, 0.65, 0.35), power: 7.0, range: 7.0, bulb: 0.08,
            circle: (radius: (1.2, 0.6), period: 10.0)),
        (at: (2.4, 2.2, 0.5), color: (0.40, 0.65, 1.0), power: 5.0, range: 6.0, bulb: 0.08),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),

        // Звезда с круглой дырой посередине.
        (name: "звезда", material: "золото", at: (-2.2, 1.1, 0.0), spin: (0.0, 30.0, 0.0),
            shape: Subtract(
                base: Extrude(
                    profile: "M 0 1 L 0.22 0.3 L 0.95 0.31 L 0.36 -0.12 L 0.59 -0.81 L 0 -0.38 L -0.59 -0.81 L -0.36 -0.12 L -0.95 0.31 L -0.22 0.3 Z",
                    depth: 0.25, round: 0.02),
                cut: [Move(turn: (90.0, 0.0, 0.0), shape: Cylinder(height: 1.0, radius: 0.15))],
                smooth: 0.02)),

        // Сердце из кривых Безье, скруглённые рёбра, покачивается.
        (name: "сердце", material: "красный", at: (-0.6, 1.2, 0.8), turn: (0.0, -15.0, 0.0),
            bob: (by: (0.0, 0.15, 0.0), period: 4.0),
            shape: Extrude(
                profile: "M 0 -0.6 C -0.2 -0.4 -0.7 -0.1 -0.7 0.25 C -0.7 0.55 -0.45 0.7 -0.25 0.7 C -0.1 0.7 0 0.6 0 0.5 C 0 0.6 0.1 0.7 0.25 0.7 C 0.45 0.7 0.7 0.55 0.7 0.25 C 0.7 -0.1 0.2 -0.4 0 -0.6 Z",
                depth: 0.35, round: 0.1)),

        // Ваза: стенка — контур с внешней и внутренней стороной.
        (name: "ваза", material: "керамика", at: (0.9, 0.0, 0.3),
            shape: Revolve(
                profile: "M 0 0 L 0.35 0 C 0.55 0.3 0.12 0.6 0.16 0.95 L 0.26 1.15 L 0.21 1.17 L 0.11 0.97 C 0.06 0.6 0.48 0.32 0.29 0.06 L 0 0.06 Z")),

        // Пешка: тело вращения, плавно слитое с шаром-головой.
        (name: "пешка", material: "камень", at: (2.1, 0.0, -0.5), shape: Union(smooth: 0.06, shapes: [
            Revolve(profile: "M 0 0 L 0.32 0 L 0.32 0.07 L 0.2 0.12 Q 0.1 0.35 0.1 0.6 L 0.2 0.64 L 0.2 0.69 L 0 0.69 Z"),
            Move(at: (0.0, 0.82, 0.0), shape: Sphere(radius: 0.16)),
        ])),

        // Бублик: круг, отодвинутый от оси.
        (name: "бублик", material: "оранжевый", at: (-0.4, 0.15, -1.4), spin: (0.0, 20.0, 0.0),
            shape: Revolve(
                profile: "M 0.15 0 A 0.15 0.15 0 1 1 -0.15 0 A 0.15 0.15 0 1 1 0.15 0 Z",
                offset: 0.45)),

        // Указатель: столбик и тонкая стрелка.
        (name: "указатель", material: "дерево", at: (2.6, 0.0, 1.5), turn: (0.0, -30.0, 0.0),
            shape: Union(shapes: [
                Move(at: (0.0, 0.7, 0.0), shape: Capsule(height: 1.4, radius: 0.04)),
                Move(at: (0.3, 1.35, 0.06), shape: Extrude(
                    profile: "M -0.6 -0.12 L 0.25 -0.12 L 0.25 -0.3 L 0.6 0 L 0.25 0.3 L 0.25 0.12 L -0.6 0.12 Z",
                    depth: 0.04)),
            ])),

        // Облако позади: плоский слой 2D-фона, только с тенью и светом.
        (name: "облако", material: "облако", at: (0.0, 2.4, -3.0),
            bob: (by: (0.3, 0.0, 0.0), period: 12.0),
            shape: Extrude(
                profile: "M -1.0 0 A 0.35 0.35 0 0 0 -0.5 0.3 A 0.45 0.45 0 0 0 0.3 0.45 A 0.4 0.4 0 0 0 0.9 0.2 A 0.25 0.25 0 0 0 1.0 0 Z",
                depth: 0.03)),
    ],
)
