// Модели из файлов glTF (этап 8.14). Запуск:
//     .\run.bat --space-file scenes\3d\models.ron
// потом клавиша I.
//
// Что смотреть:
// - станок из файла models/machine.glb: станина, оранжевый корпус, два бака, труба и
//   дымоход — цвета взяты из материалов файла;
// - второй станок — та же модель вдвое меньше, крашенная одним материалом сцены
//   («золото»), крутится;
// - деревянный ящик из models/crate.glb с текстурой досок (8.14б2): картинка лежит
//   внутри файла, вдали не рябит (уменьшенные копии текстуры);
// - тени: каждый выпуклый кусок модели бросает тень (бак, труба, корпус, ящик);
// - рядом встроенная коробка и гладкий шар SDF для сравнения.
//
// Модель пишется так: mesh: Model(file: "путь от папки этого файла", scale: 1.0).
// Без material — цвета из файла, с material — вся модель одним материалом сцены.
// Подходят .glb и .gltf с файлом .bin рядом. Нормали из файла дают гладкие грани (баки,
// труба), без них грани плоские. Текстура цвета (PNG или JPEG) рисуется, если у модели
// нет своего material; тень у невыпуклых кусков появится с «кирпичом поля» (8.15).
// Сохранил этот файл или модель — сцена перечитывается сама.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (2.6, 2.2, 3.6), look_at: (0.0, 0.6, 0.0))),

    materials: [
        (name: "пол", color: (0.18, 0.19, 0.21), grid: true),
        (name: "золото", color: (0.90, 0.75, 0.25)),
        (name: "синий", color: (0.25, 0.55, 0.85)),
        (name: "слизь", color: (0.30, 0.80, 0.35)),
    ],

    lamps: [
        (at: (1.2, 2.4, 1.8), color: (1.0, 0.85, 0.65), power: 7.0, range: 7.0, bulb: 0.08),
        (at: (-2.0, 1.8, -1.0), color: (0.45, 0.65, 1.0), power: 4.0, range: 5.0, bulb: 0.08,
            circle: (radius: (0.8, 0.6), period: 10.0)),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        (name: "шар", material: "слизь", at: (-1.4, 0.45, 1.2), shape: Sphere(radius: 0.45)),
    ],

    meshes: [
        (name: "станок", at: (0.0, 0.0, 0.0), turn: (0.0, -20.0, 0.0),
            mesh: Model(file: "models/machine.glb")),
        (name: "малый станок", material: "золото", at: (1.6, 0.0, -1.3),
            mesh: Model(file: "models/machine.glb", scale: 0.5), spin: (0.0, 30.0, 0.0)),
        (name: "ящик", at: (-0.2, 0.0, 1.3), turn: (0.0, 15.0, 0.0),
            mesh: Model(file: "models/crate.glb")),
        (name: "коробка", material: "синий", at: (-1.6, 0.3, -0.9), turn: (0.0, 25.0, 0.0),
            mesh: Block(size: (0.6, 0.6, 0.6))),
    ],
)
