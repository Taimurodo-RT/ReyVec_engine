// Сцена «выставка» (итог этапа 8, docs/roadmap.md): всё остальное, что умеет быстрый
// режим 3D, в одном кадре — чтобы одной сценой проверить, что ничего не сломалось.
// Запуск:
//     .\run.bat --space-file scenes\3d\showroom.ron
// потом клавиша I.
//
// Двор под открытым небом: светит солнце, под навесом — лампы. Что где стоит:
// - слева модели из файлов glTF: станок (цвета из файла, гладкие баки), ящик с
//   текстурой досок, малый станок крутится;
// - посередине формы SDF: слитые капли, куб с вырезанным шаром, тор, конус, капсула —
//   с мягкими тенями и затенением в углах;
// - справа модели форм из кузницы: наковальня, молот, ведро, слитки; горн с углями
//   светится (ореол);
// - сзади зеркало во всю стену и хромовый шар: в них видны и формы, и свет; пол чуть
//   глянцевый — размытое отражение;
// - под навесом тень от солнца и свет двух ламп, одна ходит по кругу;
// - движение: шар прыгает, тор и малый станок крутятся, лампа летает.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (0.0, 2.3, 7.2), look_at: (0.0, 0.8, 0.0))),

    materials: [
        (name: "пол", color: (0.24, 0.24, 0.25), grid: true, shine: 0.10, rough: 0.30),
        (name: "бетон", color: (0.60, 0.59, 0.56)),
        (name: "дерево", color: "#6b4a2b"),
        (name: "камень", color: "#6e6a66"),
        (name: "зеркало", color: (0.80, 0.82, 0.85), shine: 0.92),
        (name: "хром", color: (0.75, 0.75, 0.78), shine: 0.8),
        (name: "золото", color: (0.95, 0.75, 0.30), shine: 0.55, rough: 0.25),
        (name: "слизь", color: (0.30, 0.80, 0.35)),
        (name: "синий", color: (0.25, 0.55, 0.85)),
        (name: "красный", color: (0.85, 0.30, 0.15), shine: 0.08),
        (name: "угли", color: (1.0, 0.42, 0.12), glow: 3.0),
    ],

    lamps: [
        (at: (-3.2, 2.3, -1.2), color: (1.0, 0.90, 0.75), power: 6.0, range: 6.0, bulb: 0.08),
        (at: (3.2, 2.0, -1.0), color: (0.55, 0.70, 1.0), power: 5.0, range: 5.0, bulb: 0.08,
            circle: (radius: (0.8, 0.6), period: 10.0)),
        (at: (3.4, 1.0, 0.4), color: (1.0, 0.55, 0.25), power: 2.5, range: 3.0),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),

        // Задняя стена с зеркалом и навес на четырёх столбах.
        (name: "стена", material: "бетон", at: (0.0, 1.5, -3.2), shape: Box(size: (11.0, 3.0, 0.3), round: 0.0)),
        (name: "зеркало", material: "зеркало", at: (0.0, 1.5, -3.02), shape: Box(size: (4.0, 2.2, 0.06), round: 0.02)),
        (name: "навес", material: "дерево", at: (0.0, 3.1, -1.4), shape: Box(size: (11.0, 0.12, 3.6), round: 0.02)),
        (name: "столб 1", material: "дерево", at: (-5.2, 1.55, 0.3), shape: Box(size: (0.16, 3.1, 0.16), round: 0.02)),
        (name: "столб 2", material: "дерево", at: (-1.8, 1.55, 0.3), shape: Box(size: (0.16, 3.1, 0.16), round: 0.02)),
        (name: "столб 3", material: "дерево", at: (1.8, 1.55, 0.3), shape: Box(size: (0.16, 3.1, 0.16), round: 0.02)),
        (name: "столб 4", material: "дерево", at: (5.2, 1.55, 0.3), shape: Box(size: (0.16, 3.1, 0.16), round: 0.02)),

        // Формы SDF.
        (name: "капли", material: "слизь", at: (-1.0, 0.0, 1.2),
            shape: Union(smooth: 0.25, shapes: [
                Move(at: (0.0, 0.35, 0.0), shape: Sphere(radius: 0.35)),
                Move(at: (0.45, 0.25, 0.1), shape: Sphere(radius: 0.25)),
                Move(at: (0.1, 0.05, 0.1), shape: Cylinder(height: 0.1, radius: 0.7, round: 0.04)),
            ])),
        (name: "куб с дырой", material: "синий", at: (0.5, 0.5, 0.6), turn: (0.0, 25.0, 0.0),
            shape: Subtract(base: Box(size: (1.0, 1.0, 1.0), round: 0.04), cut: [Sphere(radius: 0.62)], smooth: 0.03)),
        (name: "тор", material: "золото", at: (-0.4, 1.0, -0.6), spin: (40.0, 60.0, 0.0),
            shape: Torus(radius: 0.4, thickness: 0.11)),
        (name: "конус", material: "красный", at: (1.4, 0.45, 1.6), shape: Cone(height: 0.9, bottom: 0.35, top: 0.05, round: 0.02)),
        (name: "капсула", material: "бетон", at: (-2.0, 0.55, 2.0), turn: (0.0, 0.0, 30.0),
            shape: Capsule(height: 0.8, radius: 0.16)),
        (name: "прыгун", material: "красный", at: (0.0, 1.05, 2.4), bob: (by: (0.0, 0.7, 0.0), period: 1.6),
            shape: Sphere(radius: 0.3)),
        (name: "хромовый шар", material: "хром", at: (1.5, 0.55, -1.6), shape: Sphere(radius: 0.55)),

        // Модели форм из кузницы.
        (name: "пень", material: "дерево", at: (3.2, 0.25, 1.0), shape: Cylinder(height: 0.5, radius: 0.22, round: 0.02)),
        (name: "наковальня", material: "камень", at: (3.2, 0.5, 1.0), turn: (0.0, -15.0, 0.0),
            shape: Use(model: "кузница/наковальня")),
        (name: "молот", material: "камень", at: (3.15, 0.99, 1.02), turn: (0.0, 35.0, 0.0),
            shape: Use(model: "кузница/молот")),
        (name: "ведро", material: "камень", at: (2.5, 0.0, 1.7), shape: Use(model: "кузница/ведро")),
        (name: "слитки", material: "камень", at: (4.2, 0.0, 1.5), turn: (0.0, 20.0, 0.0),
            shape: Use(model: "кузница/слитки")),
        (name: "горн", material: "камень", at: (3.6, 0.35, -1.6), shape: Box(size: (0.9, 0.7, 0.7), round: 0.03)),
        (name: "угли", material: "угли", at: (3.6, 0.72, -1.6), shape: Use(model: "кузница/угли")),
    ],

    meshes: [
        (name: "станок", at: (-3.6, 0.0, -1.2), turn: (0.0, 20.0, 0.0),
            mesh: Model(file: "models/machine.glb")),
        (name: "малый станок", material: "золото", at: (-4.3, 0.0, 1.2),
            mesh: Model(file: "models/machine.glb", scale: 0.5), spin: (0.0, 30.0, 0.0)),
        (name: "ящик", at: (-2.8, 0.0, 0.9), turn: (0.0, 15.0, 0.0),
            mesh: Model(file: "models/crate.glb")),
    ],
)
