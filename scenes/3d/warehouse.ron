// Склад: 8 стеллажей по 59 деталей (М.1, docs/models-3d.md). Запуск:
//     .\run.bat --space-file scenes\3d\warehouse.ron
// потом клавиша I.
//
// Сцена для замера границ частей внутри моделей. На панели флажок «Границы частей
// внутри моделей»: выключите и сравните время «лучи 3D» — вид тот же, а без границ
// каждый шаг луча возле стеллажа считает все его 59 деталей. Со «Счётчиками лучей 3D»
// столбец «прим» показывает, сколько деталей в среднем считает один расчёт сцены.
//
// Стеллаж — models/склад/стеллаж.shape.ron: стойки и пятки зеркалом, полки, ящики и
// бочки повтором. Все детали покрашены в модели, материал предмета им не нужен.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (-5.6, 1.7, 0.4), look_at: (0.0, 1.0, -0.2))),

    materials: [
        (name: "пол", color: (0.30, 0.30, 0.31), grid: true),
    ],

    lamps: [
        (at: (-2.2, 3.2, 0.0), color: (1.0, 0.95, 0.88), power: 7.0, range: 8.0),
        (at: (2.2, 3.2, 0.0), color: (1.0, 0.95, 0.88), power: 7.0, range: 8.0),
        (at: (-6.0, 2.0, 1.5), color: (0.85, 0.9, 1.0), power: 3.0, range: 6.0),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        (name: "стеллаж 1", material: "пол", at: (-3.3, 0.0, -1.2), turn: (0.0, 0.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 2", material: "пол", at: (-1.1, 0.0, -1.2), turn: (0.0, 0.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 3", material: "пол", at: (1.1, 0.0, -1.2), turn: (0.0, 0.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 4", material: "пол", at: (3.3, 0.0, -1.2), turn: (0.0, 0.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 5", material: "пол", at: (-3.3, 0.0, 1.2), turn: (0.0, 180.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 6", material: "пол", at: (-1.1, 0.0, 1.2), turn: (0.0, 180.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 7", material: "пол", at: (1.1, 0.0, 1.2), turn: (0.0, 180.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
        (name: "стеллаж 8", material: "пол", at: (3.3, 0.0, 1.2), turn: (0.0, 180.0, 0.0),
            shape: Use(model: "склад/стеллаж")),
    ],
)
