// Кузница: модели форм (М.0, docs/models-3d.md). Запуск:
//     .\run.bat --space-file scenes\3d\forge.ron
// потом клавиша I.
//
// Что смотреть:
// - наковальня (models/кузница/наковальня.shape.ron): рог — конус Cone, лапы — одна лапа
//   и её зеркало Mirror;
// - стопка медных слитков и угли в горне — повтор Repeat (угли — повтор повтора);
// - ведро — конус, из которого вырезан конус поменьше, с водой;
// - молот на наковальне, второй молот — та же модель на полу;
// - раскалённая заготовка на наковальне — глина (М.9): сетка расстояний из файла
//   models/кузница/заготовка.clay со следами молота, сделанными кистями.
//
// Предмет пишет shape: Use(model: "кузница/наковальня") — это файл
// models/кузница/наковальня.shape.ron рядом с этим файлом. Сохранил модель — сцена
// перечитывается сама, меняются все её копии.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (1.25, 1.15, 1.35), look_at: (-0.25, 0.45, -0.15))),

    materials: [
        (name: "пол", color: (0.22, 0.20, 0.18), grid: true),
        (name: "дерево", color: "#6b4a2b"),
        (name: "камень", color: "#6e6a66"),
        (name: "угли", color: (1.0, 0.42, 0.12), glow: 3.0),
    ],

    lamps: [
        (at: (0.9, 1.9, 1.2), color: (1.0, 0.92, 0.80), power: 6.0, range: 7.0),
        (at: (-1.2, 1.0, -0.6), color: (1.0, 0.55, 0.25), power: 3.0, range: 3.5),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        (name: "пень", material: "дерево", at: (0.0, 0.25, 0.0),
            shape: Cylinder(height: 0.5, radius: 0.22, round: 0.02)),
        (name: "наковальня", material: "камень", at: (0.0, 0.5, 0.0), turn: (0.0, -15.0, 0.0),
            shape: Use(model: "кузница/наковальня")),
        (name: "молот", material: "камень", at: (-0.05, 0.99, 0.02), turn: (0.0, 35.0, 0.0),
            shape: Use(model: "кузница/молот")),
        // Раскалённая заготовка из глины (М.9): её мнут кистями в «Формах».
        (name: "заготовка", material: "камень", at: (0.12, 0.978, 0.045), turn: (0.0, -15.0, 0.0),
            shape: Use(model: "кузница/заготовка")),
        (name: "молот на полу", material: "камень", at: (0.55, 0.03, 0.45), turn: (0.0, -60.0, 0.0),
            shape: Use(model: "кузница/молот")),
        (name: "горн", material: "камень", at: (-1.3, 0.35, -0.6),
            shape: Box(size: (0.9, 0.7, 0.7), round: 0.03)),
        (name: "угли", material: "угли", at: (-1.3, 0.72, -0.6),
            shape: Use(model: "кузница/угли")),
        (name: "слитки", material: "камень", at: (0.75, 0.0, -0.55), turn: (0.0, 20.0, 0.0),
            shape: Use(model: "кузница/слитки")),
        (name: "ведро", material: "камень", at: (-0.6, 0.0, 0.55),
            shape: Use(model: "кузница/ведро")),
    ],
)
