// Сцена «эффекты» (8.16, docs/roadmap.md): свечение, светящиеся материалы, блики и
// переход к белому в 3D. Запуск:
//     .\run.bat --space-file scenes\3d\effects.ron
// потом клавиша I.
//
// Зал закрыт крышей: солнца внутри нет, свет — от ламп и от того, что светится само.
// Что смотреть:
// - ряд шаров слева: один цвет, свечение 0,5, 1, 2, 4 и 8. Чем ярче, тем шире ореол, а
//   самый яркий белеет посередине (пересвет), но по краю остаётся оранжевым;
// - неоновые трубки на стене: три цвета, ореол ложится на стену и пол;
// - раскалённая заготовка на наковальне: от тёмно-красного края к жёлтому концу;
// - хромовый шар и глянцевый пол: в них видно всё, что светится, блики от ламп;
// - кольцо, которое крутится, и шарик, который летает по кругу: ореол идёт за ними
//   без хвоста (свечение считается в каждом кадре заново, памяти у него нет).
// На панели флажок «Свечение» выключает ореол и переход к белому — для сравнения.
(
    format: "reyvec-space",
    version: 1,
    camera: Some((eye: (0.0, 1.7, 5.2), look_at: (0.0, 1.0, -1.0))),

    materials: [
        (name: "пол", color: (0.10, 0.10, 0.11), shine: 0.25, rough: 0.15),
        (name: "стены", color: (0.16, 0.16, 0.18)),
        (name: "камень", color: "#5c5854"),
        (name: "хром", color: (0.75, 0.75, 0.78), shine: 0.8),
        (name: "жар 0,5", color: (1.0, 0.42, 0.12), glow: 0.5),
        (name: "жар 1", color: (1.0, 0.42, 0.12), glow: 1.0),
        (name: "жар 2", color: (1.0, 0.42, 0.12), glow: 2.0),
        (name: "жар 4", color: (1.0, 0.42, 0.12), glow: 4.0),
        (name: "жар 8", color: (1.0, 0.42, 0.12), glow: 8.0),
        (name: "неон красный", color: (1.0, 0.12, 0.25), glow: 5.0),
        (name: "неон зелёный", color: (0.15, 1.0, 0.35), glow: 5.0),
        (name: "неон синий", color: (0.20, 0.45, 1.0), glow: 5.0),
        (name: "металл красный", color: (0.80, 0.10, 0.03), glow: 0.8),
        (name: "металл оранжевый", color: (1.0, 0.35, 0.06), glow: 2.0),
        (name: "металл жёлтый", color: (1.0, 0.75, 0.30), glow: 5.0),
        (name: "искра", color: (1.0, 0.85, 0.50), glow: 10.0),
    ],

    lamps: [
        (at: (-3.0, 2.9, 1.0), color: (1.0, 0.92, 0.80), power: 2.5, range: 6.0),
        (at: (3.0, 2.9, 1.0), color: (0.80, 0.90, 1.0), power: 2.5, range: 6.0),
        // Свет от того, что светится: быстрый режим сам его не считает, поэтому рядом
        // со светящимся стоит лампа его цвета (ниже третьей лампы — без теней).
        (at: (-1.6, 2.4, -3.25), color: (1.0, 0.12, 0.25), power: 0.7, range: 3.0),
        (at: (0.0, 2.0, -3.25), color: (0.15, 1.0, 0.35), power: 0.7, range: 3.0),
        (at: (1.6, 1.6, -3.25), color: (0.20, 0.45, 1.0), power: 0.7, range: 3.0),
        (at: (0.52, 1.0, 1.2), color: (1.0, 0.55, 0.15), power: 0.9, range: 2.0),
        (at: (-1.2, 0.75, -1.0), color: (1.0, 0.42, 0.12), power: 1.2, range: 3.0),
        (at: (2.4, 1.5, 0.0), color: (1.0, 0.85, 0.50), power: 0.8, range: 2.5, circle: (radius: (1.1, 1.1), period: 4.0)),
    ],

    objects: [
        (name: "пол", material: "пол", shape: Plane(normal: (0.0, 1.0, 0.0), offset: 0.0)),
        (name: "крыша", material: "стены", at: (0.0, 3.65, 0.0), shape: Box(size: (13.0, 0.3, 13.0), round: 0.0)),
        (name: "стена север", material: "стены", at: (0.0, 1.75, -3.65), shape: Box(size: (13.0, 3.5, 0.3), round: 0.0)),
        (name: "стена юг", material: "стены", at: (0.0, 1.75, 6.65), shape: Box(size: (13.0, 3.5, 0.3), round: 0.0)),
        (name: "стена запад", material: "стены", at: (-6.35, 1.75, 1.5), shape: Box(size: (0.3, 3.5, 10.6), round: 0.0)),
        (name: "стена восток", material: "стены", at: (6.35, 1.75, 1.5), shape: Box(size: (0.3, 3.5, 10.6), round: 0.0)),

        // Ряд шаров: свечение 0,5 … 8.
        (name: "шар 0,5", material: "жар 0,5", at: (-4.4, 0.3, 0.6), shape: Sphere(radius: 0.3)),
        (name: "шар 1", material: "жар 1", at: (-3.6, 0.3, 0.2), shape: Sphere(radius: 0.3)),
        (name: "шар 2", material: "жар 2", at: (-2.8, 0.3, -0.2), shape: Sphere(radius: 0.3)),
        (name: "шар 4", material: "жар 4", at: (-2.0, 0.3, -0.6), shape: Sphere(radius: 0.3)),
        (name: "шар 8", material: "жар 8", at: (-1.2, 0.3, -1.0), shape: Sphere(radius: 0.3)),

        // Неоновые трубки на северной стене.
        (name: "неон 1", material: "неон красный", at: (-1.6, 2.4, -3.42), turn: (0.0, 0.0, 90.0),
            shape: Capsule(height: 2.4, radius: 0.035)),
        (name: "неон 2", material: "неон зелёный", at: (0.0, 2.0, -3.42), turn: (0.0, 0.0, 90.0),
            shape: Capsule(height: 2.4, radius: 0.035)),
        (name: "неон 3", material: "неон синий", at: (1.6, 1.6, -3.42), turn: (0.0, 0.0, 90.0),
            shape: Capsule(height: 2.4, radius: 0.035)),

        // Наковальня с раскалённой заготовкой: три куска от края к концу.
        (name: "пень", material: "камень", at: (0.4, 0.3, 1.2), shape: Cylinder(height: 0.6, radius: 0.3, round: 0.02)),
        (name: "наковальня", material: "камень", at: (0.4, 0.72, 1.2), shape: Box(size: (0.8, 0.24, 0.3), round: 0.03)),
        (name: "заготовка 1", material: "металл красный", at: (0.16, 0.87, 1.2), shape: Box(size: (0.24, 0.05, 0.07), round: 0.01)),
        (name: "заготовка 2", material: "металл оранжевый", at: (0.40, 0.87, 1.2), shape: Box(size: (0.24, 0.05, 0.07), round: 0.01)),
        (name: "заготовка 3", material: "металл жёлтый", at: (0.64, 0.87, 1.2), shape: Box(size: (0.24, 0.05, 0.07), round: 0.01)),

        // Хром и то, что движется.
        (name: "хромовый шар", material: "хром", at: (2.4, 0.6, 0.0), shape: Sphere(radius: 0.6)),
        (name: "кольцо", material: "неон синий", at: (3.9, 1.1, -1.2), spin: (0.0, 60.0, 35.0),
            shape: Torus(radius: 0.55, thickness: 0.04)),
        (name: "искра", material: "искра", at: (2.4, 1.5, 0.0), circle: (radius: (1.1, 1.1), period: 4.0),
            shape: Sphere(radius: 0.05)),
    ],
)
