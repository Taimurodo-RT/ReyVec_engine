// Пример «кузнец и руда»: задание. Руду считает скрипт: quest.add("mech", "ruda", 1).
(
    format: "reyvec-quest",
    version: 1,
    id: "mech",
    title: "Меч для героя",
    stages: [
        (id: "ruda", journal: "Кузнец выкует меч, если принести три куска руды.", goals: [(id: "ruda", text: "Руда", count: 3)], next: "otnesti"),
        (id: "otnesti", journal: "Руда собрана. Отнести её кузнецу.", next: "zhdat"),
        (id: "zhdat", journal: "Кузнец куёт меч. Зайти к нему завтра."),
    ],
)
