// Пример «кузнец и руда»: первая встреча и взятие задания «меч».
(
    format: "reyvec-dialog",
    version: 1,
    id: "kuznec.privet",
    title: "Кузнец: приветствие",
    with: ["kuznec", "hero"],
    nodes: [
        Check(id: "nachalo", at: (0, 0), when: "kuznec.znakom", yes: "po_imeni", no: "znakomstvo"),
        Set(id: "znakomstvo", at: (240, 120), changes: [(var: "kuznec.znakom", to: true)], next: "chuzhak"),
        Line(id: "chuzhak", at: (480, 120), who: "kuznec", text: "Чего надо, чужак? Я кузнец, если что.", next: "vopros"),
        Line(id: "po_imeni", at: (480, -120), who: "kuznec", text: "А, {hero.name}! Заходи.", settings: (mood: "dobryi"), next: "vopros"),
        Line(id: "vopros", at: (720, 0), who: "kuznec", text: "Что тебе нужно?", choices: [
            (text: "Мне нужен меч.", when: "quest.mech.state == \"none\"", next: "pro_mech"),
            (text: "Я принёс руду.", when: "quest.mech.stage == \"otnesti\"", next: "k_rude"),
            (text: "Просто смотрю.", next: "proshchai"),
        ]),
        Line(id: "pro_mech", at: (960, -160), who: "kuznec", text: "Меч? Принеси три куска руды — выкую.", settings: (camera: true), next: "vzyat"),
        Event(id: "vzyat", at: (1200, -160), name: "quest.start", args: ["mech"], next: "konec"),
        Jump(id: "k_rude", at: (960, 0), dialog: "kuznec.ruda"),
        Line(id: "proshchai", at: (960, 160), who: "kuznec", text: "Смотри, только руками не трогай.", next: "konec"),
        End(id: "konec", at: (1440, 0)),
    ],
)
